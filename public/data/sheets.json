\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"\n\"Theme\",\"Begin with the End in mind\",\"recovery\",\"Change\",\"Your favorite 'Korean word' \",\"Value\",\"Speech\",\"A White Lie\",\"\",\"\",\"The power of small decision \",\"sleep health\",\"System\",\"\",\"The Great Outdoors\",\"“A New Quarter, A New Strategy”\",\"Kindness\",\"\",\"Nature \",\"adjustment\",\"\",\"healthy daily routine\",\"\",\"small care, deeply moved\",\"\",\"Summer\",\"Challenge\",\"Survival Guide to Summer\",\"Halfway There\",\"Adventure \",\"Fun\",\"carefree memories \",\"Analytical Thinking\",\"Courage\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"\n\"Theme Question\",\"When you think about the end of 2026, what do you want to be proud of?\",\"What healed you from physical or mental pain?\",\"If you could completely change one person's behavior, who would it be and how would you change it?\",\"What's your favorite Korean word to share with the world?\",\"How do you define value? What value is the most valuable in your life?\",\"What makes a speech truly memorable?\",\"How do you define a white lie? when do we/you need one?\",\"\",\"\",\"What is one small decision that changed the direction of your life?\",\"Sleep is better than medicine. How about your pattern?\",\"What is the most/ effective system you’ve experienced and what made it work so well?\",\"\",\"If you could spend your ideal spring day anywhere in the world, what activities would you be doing?\",\"How would you approach setting a new strategy for the next three months?\",\"How do you show kindness?\",\"\",\"When was a time you felt healed by nature?\",\"Have you ever had to make a major adjustment to your plans?\",\"\",\"What is your sexy food?\",\"\",\"When were you deeply moved by someone's small care?\",\"\",\"What are your plans for this summer?\",\"If you could take on one new challenge today, what would it be?\n\",\"What is the single most essential item in your summer survival kit?\",\"As we reach the midpoint of the year, what were my New Year's resolutions, and what progress have I made so far?\",\"What was the best adventure you went on?\",\"What is the most fun activity you have ever tried?\",\"please share your carefree memories.\",\"\nWhat's your own way of breaking down a complex problem?\",\"Tell us about a moment when you had to be courageous — big or small.\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"\n\"Word of the day\",\"Envision\",\"rebound\",\"\",\"\",\"silver\",\"Emerge\",\"Diplomatic\",\"\",\"\",\"\",\"candid\",\"\",\"\",\"downplay\",\"Prioritize (verb)\",\"\",\"\",\"\",\"Skeptical: Having doubts that a claim or statement is true or that something will happen\",\"\",\"\",\"\",\"undermine\",\"outlast\",\"clutter\",\"fluctuation\",\"Outlast\",\"suspicious: the sense (but not certainty) that an observation or result is linked to a problem, diagnosis, or outcome\",\"Constraint\",\"Kindle : to start a fire (literal), To inspire or awaken something (figurative)\",\"halcyon\",\"turbulent\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"\n\"Quote of the day\",\"A goal without a plan is just a wish.\",\"Fall seven times, stand up eight.\",\"\",\"\",\"There's no silver bullet for fixing  climate change.\",\"\",\"A white lie is the sugar coating on the bitter pill of truth.\",\"\",\"\",\"\",\"“Be candid, be brief, be seated.”\n— Franklin D. Roosevelt\",\"\",\"\",\"\"\"When you download your strengths, others will, too\"\"\",\"“What is important is seldom urgent, and what is urgent is seldom important.”\r\n— Dwight D. Eisenhower\",\"\",\"\",\"\",\"\"\"Extraordinary claims require extraordinary evidence.\"\" — Carl Sagan\",\"\",\"\",\"\",\"Comfort zones quietly undermine the courage needed for growth\",\"\"\"The strongest aren't those who never struggle—they're the ones who outlast the struggle.\"\"\",\"\"\"Clutter is what happens to things when they become useless but friendly.\"\" \",\"Have you had any fluctuations in your daily life recently?\",\"\"\"The strongest aren't those who never struggle—they're the ones who outlast the struggle.\"\"\",\"Suspicion always haunts the guilty mind. - William Shakespeare -\",\"The more constraints one imposes, the more one frees oneself\",\"The mind is not a vessel to be filled, but a fire to be kindled\",\"We don't remember days,we remember mements\",\"The greatest danger in times of turbulence is not the turbulence; it is to act with yesterday's logic.\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"\n\"Best Speaker\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"